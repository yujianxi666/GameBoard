# 统一行尾为 LF，避免在 Windows 上提交后仓库里混入 CRLF
* text=auto eol=lf

# 图片与二进制资源不做行尾转换
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary

# 文本文件显式标记
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
